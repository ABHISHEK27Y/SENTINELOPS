# ─────────────────────────────────────────────────────────────
# SentinelOps environment configuration (copy to .env)
# Never commit real secrets. This file documents every variable.
# ─────────────────────────────────────────────────────────────

# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_pw
POSTGRES_DB=sentinelops
# Full URL form used by services/migrations
DATABASE_URL=postgresql://sentinel:sentinel_dev_pw@localhost:5432/sentinelops

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sentinelops

# ---- OpenTelemetry ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=sentinelops
# Sampling ratio 0.0 - 1.0
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- Observability endpoints (for reference / dashboard links) ----
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
JAEGER_URL=http://localhost:16686

# ---- Service ports ----
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
INCIDENT_ENGINE_PORT=8090
ANOMALY_ENGINE_PORT=8091
AI_INVESTIGATOR_PORT=8092
RAG_SERVICE_PORT=8093
REMEDIATION_ENGINE_PORT=8094
API_PORT=4000
WEB_PORT=3000

# ---- Auth ----
JWT_SECRET=change_me_in_production_dev_only_secret
JWT_EXPIRES_IN=1h

# ---- AI / LLM (optional; local fallback used when unset) ----
# Provider: 'mock' (deterministic local), 'anthropic', or 'openai-compatible'
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=claude-sonnet-5
# Embeddings: 'mock' (deterministic hash-based) or 'openai-compatible'
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=384
