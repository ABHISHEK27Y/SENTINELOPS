# Copy to backend.tf and supply your pre-created protected state resources using
# terraform init -backend-config=... . Never commit backend credentials.
terraform {
  backend "s3" {
    bucket = "REPLACE_WITH_STATE_BUCKET"
    key = "sentinelops/production.tfstate"
    region = "REPLACE_WITH_REGION"
    encrypt = true
    dynamodb_table = "REPLACE_WITH_LOCK_TABLE"
  }
}
