{
  "name": "sentinelops",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Distributed Observability & Autonomous Incident Response Platform",
  "author": "Abhishhek Yadav",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "services/*",
    "control-plane/*",
    "apps/*"
  ],
  "scripts": {
    "auth:create-user": "node --import tsx apps/api/src/create-user.ts",
    "build": "npm run typecheck && npm run build -w @sentinelops/web",
    "typecheck": "npm run typecheck:backend && npm run typecheck:web && npm run typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:backend": "tsc -p tsconfig.json --pretty",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=80 --coverage.thresholds.branches=70 --coverage.thresholds.functions=80 --coverage.thresholds.statements=80",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.infra.yml down",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "db:migrate": "node --import tsx packages/db/src/cli.ts up",
    "db:status": "node --import tsx packages/db/src/cli.ts status",
    "dev:payment": "npm run dev -w @sentinelops/payment-service",
    "dev:order": "npm run dev -w @sentinelops/order-service",
    "dev:gateway": "npm run dev -w @sentinelops/api-gateway",
    "dev:anomaly": "npm run dev -w @sentinelops/anomaly-engine",
    "dev:incident": "npm run dev -w @sentinelops/incident-engine",
    "dev:ingestor": "npm run dev -w @sentinelops/ingestor"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.31.0",
    "happy-dom": "^20.14.6",
    "knip": "^6.41.0",
    "prettier": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "@opentelemetry/api": "1.9.0"
  }
}
