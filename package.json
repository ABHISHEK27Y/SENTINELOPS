{
  "name": "sentinelops",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Distributed Observability & Autonomous Incident Response Platform",
  "author": "Abhishhek Yadav",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "services/*",
    "control-plane/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.threshold.lines=80 --coverage.threshold.branches=70 --coverage.threshold.functions=80 --coverage.threshold.statements=80",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.infra.yml down",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "db:migrate": "node --import tsx packages/db/src/cli.ts up",
    "db:status": "node --import tsx packages/db/src/cli.ts status",
    "dev:payment": "npm run dev -w @sentinelops/payment-service",
    "dev:order": "npm run dev -w @sentinelops/order-service",
    "dev:gateway": "npm run dev -w @sentinelops/api-gateway",
    "dev:anomaly": "npm run dev -w @sentinelops/anomaly-engine",
    "dev:incident": "npm run dev -w @sentinelops/incident-engine",
    "dev:ingestor": "npm run dev -w @sentinelops/ingestor"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.31.0",
    "knip": "^5.32.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "~2.1.9"
  },
  "overrides": {
    "@opentelemetry/sdk-metrics": "1.27.0",
    "@opentelemetry/resources": "1.27.0",
    "@opentelemetry/sdk-trace-base": "1.27.0",
    "@opentelemetry/api": "1.9.0"
  }
}
