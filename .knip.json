{
  "$schema": "https://knip.dev/schema.json",
  "workspaces": {
    ".": {
      "entry": ["eslint.config.*", "scripts/*.{mjs,cjs}", ".github/workflows/**/*.yml"],
      "project": ["package.json", "tsconfig.json", "tsconfig.base.json"]
    },
    "apps/api": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "services/*": {
      "project": ["src/**/*.ts"]
    },
    "control-plane/*": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@vitest/coverage-v8", "recharts", "@opentelemetry/semantic-conventions"]
}
